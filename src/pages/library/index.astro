---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Badge, CardGrid } from '@astrojs/starlight/components';
import LibraryItem from '../../components/LibraryItem.astro';
import { loadLibrary } from '../../lib/data';
import { allTags, groupByType, TYPE_LABELS, withBase } from '../../lib/library';

const { items, published, titles } = await loadLibrary();
const groups = groupByType(items);
const tags = allTags(items);
const base = import.meta.env.BASE_URL;
---

<StarlightPage
	frontmatter={{ title: 'Library', tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 2 } }}
	headings={groups.map((g) => ({ depth: 2, slug: g.type, text: TYPE_LABELS[g.type] }))}
>
	<p class="tag-cloud">
		{tags.map((t) => (
			<a href={withBase(base, `/library/tags/${t}/`)}>
				<Badge text={t} />
			</a>
		))}
	</p>
	{
		groups.map((g) => (
			<section>
				<h2 id={g.type}>{TYPE_LABELS[g.type]}</h2>
				<CardGrid>
					{g.items.map((item) => (
						<LibraryItem item={item} published={published} titles={titles} />
					))}
				</CardGrid>
			</section>
		))
	}
</StarlightPage>

<style>
	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.tag-cloud a {
		text-decoration: none;
	}
</style>
