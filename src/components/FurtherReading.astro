---
// Library entries that cite this chapter, as Starlight LinkCards. Renders nothing when there are none.
import { CardGrid, LinkCard } from '@astrojs/starlight/components';
import { loadLibrary } from '../lib/data';
import { itemsForChapter } from '../lib/library';

interface Props {
	chapterId: string;
}

const { items } = await loadLibrary();
const cited = itemsForChapter(items, Astro.props.chapterId);
---

{
	cited.length > 0 && (
		<section>
			<h2 id="further-reading">Further reading</h2>
			<CardGrid>
				{cited.map((item) => (
					<LinkCard title={item.data.title} description={item.data.summary} href={item.data.url} />
				))}
			</CardGrid>
		</section>
	)
}
