---
// Library items that list this chapter. Renders nothing when there are none.
import LibraryItem from './LibraryItem.astro';
import { loadLibrary } from '../lib/data';
import { itemsForChapter } from '../lib/library';

interface Props {
	chapterId: string;
}

const { items, published, titles } = await loadLibrary();
const cited = itemsForChapter(items, Astro.props.chapterId);
---

{
	cited.length > 0 && (
		<section class="further-reading">
			<h2 id="further-reading">Further reading</h2>
			{cited.map((item) => (
				<LibraryItem item={item} published={published} titles={titles} />
			))}
		</section>
	)
}
