---
// One library entry as a Starlight Card.
import type { CollectionEntry } from 'astro:content';
import { Badge, Card, LinkButton } from '@astrojs/starlight/components';
import { publishedChapters, TYPE_ICONS, withBase } from '../lib/library';
import { brandIconFor, brandSvg } from '../lib/site-icons';
import { NEW_TAB } from '../lib/external-links';

interface Props {
	item: CollectionEntry<'library'>;
	published: Set<string>;
	titles: Map<string, string>;
}

const { item, published, titles } = Astro.props;
const { data } = item;
const base = import.meta.env.BASE_URL;
const cited = publishedChapters(data.chapters, published);
const date = data.published?.toISOString().slice(0, 10);
const brand = brandIconFor(data.url);
---

<div class="library-item" id={`item-${item.id}`}>
	<Card title={data.title} icon={TYPE_ICONS[data.type] as any}>
		<p class="meta">
			{brand && <Fragment set:html={brandSvg(brand, 'site-icon')} />}
			{data.creator}{date && <> · <time datetime={date}>{date}</time></>}
		</p>
		<p>{data.summary}</p>
		{data.note && <blockquote>{data.note}</blockquote>}
		{
			data.tags.length > 0 && (
				<p class="tags">
					{data.tags.map((t) => (
						<a href={withBase(base, `/library/tags/${t}/`)}>
							<Badge text={t} size="small" />
						</a>
					))}
				</p>
			)
		}
		{
			cited.length > 0 && (
				<p class="meta">
					Cited in{' '}
					{cited.map((c, i) => (
						<>
							{i > 0 && ', '}
							<a href={withBase(base, `/${c.id}/`)}>{titles.get(c.id) ?? c.id}</a>
						</>
					))}
				</p>
			)
		}
		<div class="actions">
			<LinkButton href={data.url} variant="secondary" icon="external" {...NEW_TAB}>Open</LinkButton>
			{
				data.links.map((l) => (
					<LinkButton href={l.url} variant="minimal" icon="external" {...NEW_TAB}>
						{l.label}
					</LinkButton>
				))
			}
		</div>
	</Card>
</div>

<style>
	/* ui-exception: muted meta line with the site's brand icon, linked Badges without underline, row layout for LinkButtons, with no Starlight equivalent; expires: 2027-01-31 */
	.library-item {
		display: grid;
	}
	/* The site's icon before the creator: muted, in its brand color on hover. */
	.library-item :global(.site-icon) {
		display: inline-block;
		width: 1em;
		height: 1em;
		margin-inline-end: 0.4em;
		vertical-align: -0.125em;
		fill: currentColor;
		color: var(--sl-color-gray-3);
		transition: color 0.15s;
	}
	.library-item:hover :global(.site-icon) {
		color: var(--hover-dark);
	}
	:global(:root[data-theme='light']) .library-item:hover :global(.site-icon) {
		color: var(--hover-light);
	}
	.meta {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.tags a {
		text-decoration: none;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 1rem;
		margin-top: 0.75rem;
	}
</style>
