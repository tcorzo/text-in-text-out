---
// In-text reference to a section of the same chapter: <SectionLink id="calling-the-model" />
// Shows the heading's current text. link={false} prints the text without a link. Unknown ids fail the build.
import { resolveSectionLink } from '../lib/library';

interface Props {
	id: string;
	link?: boolean;
}

const { id, link = true } = Astro.props;
const { headings, id: page } = Astro.locals.starlightRoute;
const text = resolveSectionLink(id, headings, page);
---

{link ? <a href={`#${id}`}>{text}</a> : text}
