---
// Starlight override: the default content with glossary mentions marked, then "Further reading" for chapters.
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import FurtherReading from './FurtherReading.astro';
import GlossaryPopover from './GlossaryPopover.astro';
import { loadGlossary } from '../lib/data';
import { mentionableIn } from '../lib/glossary';
import { withBase } from '../lib/library';
import { markMentions } from '../lib/mentions';

const { id } = Astro.locals.starlightRoute.entry;
const base = import.meta.env.BASE_URL;

const { terms, sites, order, published } = await loadGlossary();
const mentionable = order.includes(id) ? mentionableIn(id, terms, sites, order, published) : [];
const { html, marked } = markMentions(await Astro.slots.render('default'), mentionable, (t) =>
	withBase(base, `/glossary/#${t}`),
);
const popoverTerms = terms
	.filter((t) => marked.includes(t.id))
	.map((t) => ({ id: t.id, term: t.data.term, definition: t.data.definition }));
---

<Default>
	<Fragment set:html={html} />
	<FurtherReading chapterId={id} />
	{marked.length > 0 && <GlossaryPopover terms={popoverTerms} />}
</Default>
